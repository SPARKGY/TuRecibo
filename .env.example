# =============================================================================
# Variables del módulo Tu Recibo. Nombres, nunca valores.
# En producción todo lo marcado SECRETO va como referencia a Key Vault.
#
# Una referencia de Key Vault sin resolver llega como el texto literal
# `@Microsoft.KeyVault(...)`, no vacía. El módulo lo detecta y falla cerrado en
# vez de dejar pasar: si ves "no está configurada" con la variable puesta, el
# problema es el permiso de la identidad administrada sobre el vault.
# =============================================================================

# --- Base de datos ----------------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@host:5432/turecibo?schema=public&sslmode=require"

# --- Identidad del módulo dentro de CENTRIA ---------------------------------
# `CENTRIA_MODULE_CODE` tiene que ser idéntico al `code` con el que se registró
# en /admin/modules: CENTRIA lo usa para resolver qué conexiones existen.
CENTRIA_MODULE_CODE="turecibo"
CENTRIA_MODULE_NAME="Tu Recibo"
CENTRIA_MODULE_VERSION="0.1.0"

# --- Enchufe de ENTRADA: CENTRIA -> este módulo ------------------------------
# SECRETO. Lo genera CENTRIA al registrar el módulo. Viaja en `x-internal-token`.
# Protege el manifiesto, la salud y la publicación de maestros.
CENTRIA_ENTRY_TOKEN=""
# Durante una rotación, el valor anterior. Se retira cuando los logs dejan de
# avisar `[rotacion] Se aceptó ..._PREVIO`.
CENTRIA_ENTRY_TOKEN_PREVIO=""

# --- Enchufe de SALIDA: este módulo -> CENTRIA -------------------------------
# SECRETO. Es la *credencial* del módulo, distinta del token de entrada.
# Viaja en `x-service-token` junto con `x-module-code`.
CENTRIA_BASE_URL="https://centria.example.com"
CENTRIA_SERVICE_TOKEN=""
CENTRIA_SERVICE_TOKEN_PREVIO=""

# --- Disparadores ------------------------------------------------------------
# SECRETO. Solo para el workflow programado (`x-sync-token`).
SYNC_TOKEN=""
SYNC_TOKEN_PREVIO=""

# SECRETO. Solo para el robot de feriados (`x-feriados-token`).
FERIADOS_TOKEN=""
FERIADOS_TOKEN_PREVIO=""

# --- Credenciales de Tu Recibo ----------------------------------------------
# La base guarda el NOMBRE de estas variables por tenant, no su valor. Para un
# segundo tenant se agregan, por ejemplo, TURECIBO_USER_ACME / _PASSWORD_ACME y
# se los nombra en la fila de `CredencialTuRecibo`.
# SECRETO.
TURECIBO_USER=""
TURECIBO_PASSWORD=""

# --- Ventana de publicación --------------------------------------------------
# Cuántos días hacia atrás se publican las ausencias por defecto, y el techo
# duro que un consumidor puede pedir con `?ventanaDias=`. El techo existe
# porque el módulo no ve la conexión: el límite tiene que vivir de este lado.
# Si no se declaran, el código usa 31 y 400.
PUBLICACION_AUSENCIAS_DIAS="180"
PUBLICACION_AUSENCIAS_DIAS_MAX="730"

# --- Solo para el robot (GitHub Actions, no el App Service) ------------------
# TURECIBO_ADMIN_URL="https://admin.turecibo.com"
# MODULO_BASE_URL="https://turecibo.example.com"
